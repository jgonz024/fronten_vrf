# Configuración de URLs de Backend y Claves para Vite Frontend

# URL Base para consumir las APIs del Backend Next.js
VITE_API_URL=http://localhost:3000/api

# URL Servidor Backend para recursos estáticos y subidas (/uploads)
VITE_BACKEND_URL=http://localhost:3000

# Claves de almacenamiento local (Storage Keys)
VITE_JWT_STORAGE_KEY=vrf_jwt_token
VITE_SESSION_STORAGE_KEY=vrf_session
